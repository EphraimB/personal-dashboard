# Personal Dashboard Environment Variables (.env.example)
# Rename to .env.local for Raspberry Pi / Terminal / SSH deployments

# Display Scaling Mode ('tv' for 50-inch 4K TV broadcast scaling, 'laptop' for compact laptop view)
NEXT_PUBLIC_DISPLAY_MODE="tv"

# Google Calendar iCal secret URL (.ics feed)
ICAL_URL=""

# Home base street address for Radar & Mini-Map
HOME_ADDRESS=""

# LIRR Station Configuration (GTFS-Realtime)
LIRR_STATION_ID=""
LIRR_STATION_NAME=""

# NYC Ferry Configuration (GTFS-Realtime)
FERRY_STOP_ID=""
FERRY_TERMINAL_NAME=""
